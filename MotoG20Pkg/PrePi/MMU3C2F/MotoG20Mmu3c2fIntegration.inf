[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = MotoG20Mmu3c2fIntegration
  FILE_GUID                      = 2DA66E64-DB71-450B-9CE4-2302793C2F01
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 0.1

[Sources]
  ../MMU3B1/EntryPoint.S
  ../MotoG20Mmu3EnableStub.S
  ../MMU3B1/LocalEl2Vectors.S
  ../MMU3B1/MotoG20Mmu3c1Exception.S
