+/**
+  Return a stable bit mask of unavailable architectural protocols.
+
+  Bit positions follow the mArchProtocols[] order above.  The array currently
+  contains thirteen mandatory protocols, so every shift is bounded below 64.
+
+  @param[out] MissingCount  Optional count of unavailable protocols.
+
+  @return Bit mask of unavailable architectural protocols.
+
+**/
+UINT64
+CoreGetMissingArchProtocolMask (
+  OUT UINTN  *MissingCount OPTIONAL
+  )
+{
+  EFI_CORE_PROTOCOL_NOTIFY_ENTRY  *Entry;
+  UINT64                          MissingMask;
+  UINTN                           Count;
+  UINTN                           Index;
+
+  MissingMask = 0U;
+  Count       = 0U;
+  Index       = 0U;
+  for (Entry = mArchProtocols; Entry->ProtocolGuid != NULL; Entry++, Index++) {
+    if (!Entry->Present) {
+      MissingMask |= (1ULL << Index);
+      Count++;
+    }
+  }
+
+  if (MissingCount != NULL) {
+    *MissingCount = Count;
+  }
+
+  return MissingMask;
+}
